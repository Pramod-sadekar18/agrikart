# =============================================================================
# AgriKart Backend - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with production passwords to version control!
# =============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=agrikart_dev_secret_key_change_in_production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrikart_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Connection Pool Settings
DB_POOL_NAME=agrikart_pool
DB_POOL_SIZE=5
